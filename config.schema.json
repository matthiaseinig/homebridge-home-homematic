{
  "pluginAlias": "HomematicHap",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "customUi": true,
  "customUiPath": "./homebridge-ui",
  "headerDisplay": "**HomeMatic / HomematicIP** plugin with full GUI configuration. A spiritual successor to [hap-homematic](https://github.com/thkl/hap-homematic) by [@thkl](https://github.com/thkl), running as a Homebridge plugin instead of a CCU addon. Use the **custom UI** below to discover devices, expose variables and programs, and import an existing hap-homematic configuration without re-pairing accessories.",
  "footerDisplay": "Built on the architecture, configuration model and migration format pioneered by [@thkl](https://github.com/thkl) in [thkl/hap-homematic](https://github.com/thkl/hap-homematic) and [thkl/homebridge-homematic](https://github.com/thkl/homebridge-homematic) — please ⭐ those repos. Apache-2.0.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform name",
        "type": "string",
        "default": "HomematicHap",
        "required": true
      },
      "ccuIp": {
        "title": "CCU IP / hostname",
        "type": "string",
        "format": "hostname",
        "required": true,
        "placeholder": "192.168.1.10",
        "description": "Address of your Raspberrymatic / CCU3."
      },
      "interfaces": {
        "title": "CCU interfaces",
        "type": "object",
        "properties": {
          "bidcosRf":      { "title": "BidCos-RF",       "type": "boolean", "default": true  },
          "hmIpRf":        { "title": "HmIP-RF",         "type": "boolean", "default": true  },
          "bidcosWired":   { "title": "BidCos-Wired",    "type": "boolean", "default": false },
          "virtualDevices":{ "title": "VirtualDevices",  "type": "boolean", "default": true  },
          "cuxd":          { "title": "CUxD (BIN-RPC, planned)", "type": "boolean", "default": false }
        }
      },
      "interfacePorts": {
        "title": "XML-RPC port overrides",
        "type": "object",
        "description": "Override the XML-RPC ports the plugin uses to talk to each CCU interface. Leave blank to auto-discover via Interface.listInterfaces. Set explicitly only if the auto-discovered port is not reachable from this Homebridge host (e.g. blocked by the CCU firewall).",
        "properties": {
          "BidCos-RF":      { "title": "BidCos-RF port",      "type": "integer", "minimum": 1, "maximum": 65535, "placeholder": "32001" },
          "HmIP-RF":        { "title": "HmIP-RF port",        "type": "integer", "minimum": 1, "maximum": 65535, "placeholder": "32010" },
          "BidCos-Wired":   { "title": "BidCos-Wired port",   "type": "integer", "minimum": 1, "maximum": 65535, "placeholder": "32000" },
          "VirtualDevices": { "title": "VirtualDevices port", "type": "integer", "minimum": 1, "maximum": 65535, "placeholder": "39292" },
          "CUxD":           { "title": "CUxD port",           "type": "integer", "minimum": 1, "maximum": 65535, "placeholder": "8701"  }
        }
      },
      "useTls": {
        "title": "Use TLS to talk to CCU",
        "type": "boolean",
        "default": false,
        "description": "Use HTTPS for ReGa script calls. CCU self-signed certificates are accepted."
      },
      "ccuAuth": {
        "title": "CCU authentication",
        "type": "object",
        "properties": {
          "enabled":  { "title": "Use CCU authentication", "type": "boolean", "default": false },
          "username": { "title": "Username",               "type": "string"  },
          "password": { "title": "Password",               "type": "string", "format": "password" }
        }
      },
      "eventServer": {
        "title": "Local event server",
        "type": "object",
        "properties": {
          "host": {
            "title": "Bind host",
            "type": "string",
            "default": "0.0.0.0",
            "description": "Address Homebridge advertises to the CCU as the callback URL. Leave 0.0.0.0 to auto-detect."
          },
          "port": {
            "title": "Port",
            "type": "integer",
            "default": 9875,
            "minimum": 1024,
            "maximum": 65535
          },
          "watchdogSeconds": {
            "title": "Watchdog (s)",
            "type": "integer",
            "default": 300,
            "minimum": 30,
            "maximum": 3600,
            "description": "Re-init the RPC subscription if no events arrive within this window."
          }
        }
      },
      "slatWriteMode": {
        "title": "Slat write mode",
        "type": "string",
        "default": "combined",
        "oneOf": [
          { "title": "Combined (tilt as a lone COMBINED_PARAMETER L2 write)", "enum": ["combined"] },
          { "title": "LEVEL_2 then STOP (when not moving)", "enum": ["level2-then-stop"] },
          { "title": "LEVEL_2 only (legacy)", "enum": ["level2"] }
        ],
        "description": "How blinds with slats are written. If the slats do not move in HomeKit, test one blind and switch the mode."
      },
      "hapHomematicIdentity": {
        "title": "Keep hap-homematic HomeKit identities",
        "type": "boolean",
        "default": false,
        "description": "Set by the identity-preserving migration (scripts/hap-homematic-to-config.mjs --preserve-identity). Reuses hap-homematic accessory UUIDs and service layout. Do not toggle on a paired bridge: every accessory would be replaced."
      },
      "gas": {
        "title": "Gas meter (read-only)",
        "type": "object",
        "description": "HM-ES-TX-WM with gas sensor, polled through this plugin's CCU session (read-only). See docs/GAS-METER.md.",
        "properties": {
          "enabled": { "title": "Enabled", "type": "boolean", "default": false },
          "name": { "title": "HomeKit name", "type": "string", "default": "Gas Meter" },
          "address": { "title": "Channel address of the gas sensor", "type": "string", "description": "[<interface>.]<serial>:<channel>, for example BidCos-RF.<serial>:1" },
          "interface": { "title": "CCU interface", "type": "string", "default": "BidCos-RF" },
          "channel": { "title": "Channel", "type": "integer", "minimum": 1, "maximum": 50, "default": 1 },
          "datapoints": {
            "title": "Datapoints",
            "type": "object",
            "properties": {
              "counter": { "title": "Counter (m³)", "type": "string", "default": "GAS_ENERGY_COUNTER" },
              "flow": { "title": "Flow (m³/h)", "type": "string", "default": "GAS_POWER" }
            }
          },
          "pollInterval": { "title": "Poll interval (s)", "type": "integer", "minimum": 30, "maximum": 600, "default": 60 },
          "timeZone": { "title": "Time zone of the days", "type": "string", "description": "IANA name; default: this host" },
          "calorificValue": { "title": "Calorific value (kWh/m³)", "type": "number", "minimum": 8, "maximum": 13, "default": 11.2 },
          "zNumber": { "title": "Zustandszahl", "type": "number", "minimum": 0.8, "maximum": 1.0, "default": 0.95 },
          "factorPeriods": {
            "title": "Dated factors",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": { "title": "From (YYYY-MM-DD)", "type": "string" },
                "to": { "title": "To (YYYY-MM-DD, inclusive)", "type": "string" },
                "calorificValue": { "title": "Calorific value", "type": "number", "minimum": 8, "maximum": 13 },
                "zNumber": { "title": "Zustandszahl", "type": "number", "minimum": 0.8, "maximum": 1.0 }
              },
              "required": ["from"]
            }
          },
          "meterReadings": {
            "title": "Meter readings",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": { "title": "Date (YYYY-MM-DD)", "type": "string" },
                "time": { "title": "Time (HH:MM, local)", "type": "string" },
                "m3": { "title": "Reading (m³)", "type": "number", "minimum": 0 }
              },
              "required": ["date", "m3"]
            }
          },
          "bridge": { "title": "Bridge", "type": "string", "description": "host, or the name of an enabled multi-bridge. Default: the bridge whose name contains Keller, else host." },
          "api": {
            "title": "LAN API",
            "type": "object",
            "properties": {
              "bindAddress": { "title": "Bind address", "type": "string", "description": "Literal private or loopback IP of this host; empty: API off" },
              "port": { "title": "Port", "type": "integer", "minimum": 1024, "maximum": 65535, "default": 8766 }
            }
          }
        }
      },
      "channels":  { "title": "Exposed channels",  "type": "array", "items": { "$ref": "#/definitions/channelMapping"  }, "default": [] },
      "variables": { "title": "Exposed variables", "type": "array", "items": { "$ref": "#/definitions/variableMapping" }, "default": [] },
      "programs":  { "title": "Exposed programs",  "type": "array", "items": { "$ref": "#/definitions/programMapping"  }, "default": [] }
    },
    "definitions": {
      "channelMapping": {
        "type": "object",
        "properties": {
          "address": { "title": "Channel address",     "type": "string" },
          "name":    { "title": "Display name",        "type": "string" },
          "service": { "title": "Service class",       "type": "string" },
          "subtype": { "title": "Service variant",     "type": "string" },
          "settings":{ "title": "Service settings",    "type": "object" },
          "instance":{ "title": "hap-homematic bridge id", "type": "string" },
          "uuidSeed":{ "title": "hap-homematic UUID seed (do not edit)", "type": "string" }
        },
        "required": ["address", "service"]
      },
      "variableMapping": {
        "type": "object",
        "properties": {
          "name":        { "title": "Variable name",   "type": "string" },
          "displayName": { "title": "HomeKit name",    "type": "string" },
          "service":     { "title": "Service class",   "type": "string" },
          "subtype":     { "title": "Variant",         "type": "string" },
          "settings":    { "title": "Settings",        "type": "object" },
          "instance":    { "title": "hap-homematic bridge id", "type": "string" },
          "uuidSeed":    { "title": "hap-homematic UUID seed (do not edit)", "type": "string" }
        },
        "required": ["name"]
      },
      "programMapping": {
        "type": "object",
        "properties": {
          "name":        { "title": "Program name",  "type": "string" },
          "displayName": { "title": "HomeKit name",  "type": "string" },
          "settings":    { "title": "Settings",      "type": "object" }
        },
        "required": ["name"]
      }
    }
  }
}
